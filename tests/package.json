{
  "name": "saucedemo-playwright-tests",
  "version": "1.0.0",
  "description": "Playwright test suite for SauceDemo - AI QA Platform",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:login": "playwright test specs/auth/",
    "test:inventory": "playwright test specs/inventory/",
    "test:cart": "playwright test specs/cart/",
    "test:checkout": "playwright test specs/checkout/",
    "test:e2e": "playwright test specs/e2e/",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://www.saucedemo.com"
  },
  "dependencies": {
    "@playwright/test": "^1.49.0"
  }
}
