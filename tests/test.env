# Single source of truth for BASE_URL — read by both playwright.config.js
# (direct/terminal execution) and the backend's healing agent (AI Agent
# execution), so the two can never point at different environments.
#
# Points at the AI Healing Demo Site (github.com/Pooja-Marne/ai-healing-demo-website),
# a disposable static app deployed separately on Railway specifically so the
# self-healing pipeline has a safe, controllable target. Update this once
# that site's Railway URL is known.
BASE_URL=http://localhost:8080
