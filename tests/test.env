# Single source of truth for BASE_URL — read by both playwright.config.js
# (direct/terminal execution) and the backend's healing agent (AI Agent
# execution), so the two can never point at different environments.
#
# Points at the AI Healing Demo Site (github.com/Pooja-Marne/ai-healing-demo-website).
# This default is for LOCAL development — run `npm start` in
# ai-healing-demo-website/ first so something is listening on :8080.
# Production overrides this via the BASE_URL variable set directly on the
# Railway service (the deployed backend can't reach your laptop's
# localhost), pointed at the demo site's own Railway URL.
BASE_URL=http://localhost:8080
